# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini API (local dev). Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared token required by chat and manual batch Lambda URLs in deployed envs.
# Frontend users enter this token manually; do not expose it as a VITE_* value.
APP_AUTH_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_insight_hub

# Aurora (AWS deploy) — set in Lambda env, not here
# DATABASE_URL=postgresql://user:password@<aurora-cluster-endpoint>:5432/ai_insight_hub

# ── Embedding provider ────────────────────────────────────────────────────────
# bedrock  → AWS Bedrock Titan Embeddings V2  (default, used on AWS deploy)
# gemini   → Gemini gemini-embedding-001       (local dev)
# cloudflare → Cloudflare @cf/baai/bge-m3     (fallback)
EMBEDDING_PROVIDER=gemini

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Uses boto3 default credential chain (env vars, ~/.aws/credentials, or instance role)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Cloudflare (fallback) ─────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
