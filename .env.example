# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini API (local dev). Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL — used by seed/import.py AND transform/handler.py (local dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_insight_hub

# S3 bucket where raw ingestion files land (triggers transform Lambda)
S3_BUCKET=

# Transform Lambda — Aurora via Secrets Manager (AWS deploy only; local dev uses DATABASE_URL)
# DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<name>

# Transform Lambda — Bedrock model for extraction
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Aurora (AWS deploy) — set in Lambda env, not here
# DATABASE_URL=postgresql://user:password@<aurora-cluster-endpoint>:5432/ai_insight_hub

# ── Embedding provider ────────────────────────────────────────────────────────
# bedrock  → AWS Bedrock Titan Embeddings V2  (default, used on AWS deploy)
# gemini   → Gemini gemini-embedding-001       (local dev)
# cloudflare → Cloudflare @cf/baai/bge-m3     (fallback)
EMBEDDING_PROVIDER=gemini

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Uses boto3 default credential chain (env vars, ~/.aws/credentials, or instance role)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Cloudflare (fallback) ─────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
