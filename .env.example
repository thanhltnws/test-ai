# ── AWS ───────────────────────────────────────────────────────────────────────
# Shared credentials — used by all stages that touch AWS
AWS_REGION=ap-southeast-1
AWS_PROFILE=aih           # profile name in ~/.aws/config (SSO or IAM user)

# ── Seed · generate (generate.py) ────────────────────────────────────────────
# LLM provider for extraction: gemini | bedrock
SEED_LLM_PROVIDER=gemini
# Gemini key — also used by transform and application in local dev
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ── Seed · import (import.py) ─────────────────────────────────────────────────
# Embedding provider: bedrock | gemini | cloudflare
SEED_EMBEDDING_PROVIDER=gemini
# Gemini embedding model — must match the model used at RAG query time
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Database ──────────────────────────────────────────────────────────────────
# Used by: seed/import · transform · application
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_insight_hub
# Aurora (AWS deploy) — set in Lambda env via CDK, not here
# DATABASE_URL=postgresql://user:password@<aurora-cluster-endpoint>:5432/ai_insight_hub
# DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<name>

# ── Ingestion ─────────────────────────────────────────────────────────────────
S3_BUCKET=

# ── Transform ─────────────────────────────────────────────────────────────────
# Bedrock extraction model — also used by seed/generate when SEED_LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3

# ── Application ───────────────────────────────────────────────────────────────
# Shared token for chat and manual batch Lambda URLs in deployed envs.
# Frontend users enter this token manually; do not expose it as a VITE_* value.
APP_AUTH_TOKEN=

# ── Cloudflare (embedding fallback) ──────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
