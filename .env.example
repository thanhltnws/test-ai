# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini API (local dev). Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL — used by seed/import.py AND transform/handler.py (local dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_insight_hub

# ── Cloudflare Vectorize ──────────────────────────────────────────────────────
# Used by backend/seed/import.py (Vectorize stub) and RAG handler
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VECTORIZE_INDEX_NAME=ai-insight-hub

# ── AWS ───────────────────────────────────────────────────────────────────────
# Credentials — local dev uses ~/.aws/credentials; Lambda uses IAM role (leave blank here)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket where raw ingestion files land (triggers transform Lambda)
S3_BUCKET=

# Transform Lambda — Aurora via Secrets Manager (AWS deploy only; local dev uses DATABASE_URL)
# DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<name>

# Transform Lambda — Bedrock model for extraction
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
