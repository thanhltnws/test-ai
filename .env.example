# ── LLM ──────────────────────────────────────────────────────────────────────
# Gemini API (local dev). Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_insight_hub

# Aurora (AWS deploy) — set in Lambda env, not here
# DATABASE_URL=postgresql://user:password@<aurora-cluster-endpoint>:5432/ai_insight_hub

# ── Cloudflare Vectorize ──────────────────────────────────────────────────────
# Used by backend/seed/import.py (Vectorize stub) and RAG handler
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VECTORIZE_INDEX_NAME=ai-insight-hub

# ── AWS (transform pipeline) ──────────────────────────────────────────────────
# Credentials — local dev uses ~/.aws/credentials; Lambda uses IAM role (leave blank here)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# lambda_etl — input raw prefix + staging output
S3_BUCKET=
S3_RAW_PREFIX=raw/
S3_KEY=transform/staging/staging.json

# bedrock_extract — input/output keys + model
S3_STAGING_KEY=transform/staging/staging.json
S3_INSIGHTS_KEY=transform/insights/insights.json
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
