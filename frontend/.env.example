# mock = no Lambda requests; lambda = call the configured Lambda Function URLs.
VITE_DATA_SOURCE=mock
VITE_AUTH_TOKEN_STORAGE_KEY=ai-insight-hub-auth-token

# Lambda Function URLs from CDK outputs.
VITE_API_LAMBDA_URL=
VITE_CHAT_LAMBDA_URL=
VITE_BATCH_LAMBDA_URL=

# Local fallback. Vite proxies /api/* to http://localhost:3000/*.
VITE_API_URL=/api
